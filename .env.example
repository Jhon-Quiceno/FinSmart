# ============================
# Database - PostgreSQL
# ============================
DB_NAME=smartfinance
DB_USER=example_user
DB_PASSWORD=example_password
DB_PORT_EXTERNAL=5433

# ============================
# Authentication - JWT
# ============================
# Secret key para firmar los tokens JWT (usar un valor seguro en producción)
JWT_SECRET=your_jwt_secret_here
# Emisor del token, identifica la aplicación que lo generó
JWT_ISSUER=smart-finance-backend
# Tiempo de expiración del access token en milisegundos (15 min por defecto)
JWT_ACCESS_EXPIRATION_MS=900000
# Tiempo de expiración del refresh token en milisegundos (7 días por defecto)
JWT_REFRESH_EXPIRATION_MS=604800000

# ============================
# Refresh Token Cookie
# ============================
# Nombre de la cookie que almacena el refresh token
JWT_REFRESH_COOKIE_NAME=financeai_refresh_token
# 'true' solo en producción con HTTPS; 'false' para desarrollo local
JWT_REFRESH_COOKIE_SECURE=false
# Política SameSite de la cookie: Lax (recomendado), Strict o None
JWT_REFRESH_COOKIE_SAME_SITE=Lax

# ============================
# Proveedores de IA (a nivel de aplicacion)
# ============================
# Las API keys las carga el operador de la app, no los usuarios finales.
# Un proveedor se activa solo si su *_API_KEY tiene valor. Se necesita AL MENOS UNO
# para que el asistente funcione; si no hay ninguno, responde "no disponible".
# Si un proveedor falla, se prueba el siguiente automaticamente (failover transparente).
# Orden por defecto si se deja vacio: nvidia,gemini,opencode,openrouter,groq
AI_PROVIDER_PRIORITY=

NVIDIA_API_KEY=
NVIDIA_MODEL=              # opcional, default: meta/llama-3.1-70b-instruct
NVIDIA_VISION_MODEL=       # opcional, default: nvidia/nemotron-nano-12b-v2-vl

GEMINI_API_KEY=
GEMINI_MODEL=              # opcional, default: gemini-3.5-flash
GEMINI_VISION_MODEL=       # opcional, si se deja vacio usa el mismo GEMINI_MODEL (es multimodal)

OPENCODE_API_KEY=
OPENCODE_MODEL=            # opcional, default: deepseek-v4-flash-free

OPENROUTER_API_KEY=
OPENROUTER_MODEL=          # opcional, default: nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_VISION_MODEL=   # opcional, default: nvidia/nemotron-nano-12b-v2-vl:free

GROQ_API_KEY=              # opcional
GROQ_MODEL=                # opcional, default: llama-3.3-70b-versatile

# Timeout de lectura (segundos) para las llamadas HTTP a proveedores de IA.
AI_READ_TIMEOUT_SECONDS=   # opcional, default 60

# ============================
# Frontend - Next.js
# ============================
# URL del backend hacia donde el rewrite de next.config.mjs redirige /api/*.
# En Vercel debe apuntar a la URL de Cloud Run. En local, al backend de desarrollo.
# Es una variable de servidor (no NEXT_PUBLIC_): nunca llega al navegador.
BACKEND_API_URL=http://localhost:8080
# Opcional: fuerza al cliente a llamar al backend directamente en vez del proxy.
# Dejar vacia o sin definir en produccion para que las cookies sean first-party.
NEXT_PUBLIC_API_URL=

# ============================
# Email - Resend SMTP (opcional)
# ============================
# Sin estas variables, el sistema funciona solo con notificaciones dentro de la app.
RESEND_API_KEY=
MAIL_FROM=

# n8n (automatización — ver docs/roadmap-saas-cuentas-reales.md)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme
N8N_ENCRYPTION_KEY=changeme-32-char-random-string
N8N_HOST=localhost

# --- Sprint 2: integracion de Telegram (n8n) ---
# Secreto compartido entre el backend y n8n para autenticar los webhooks de
# /api/integrations/telegram/*. Generar un valor aleatorio largo, por ejemplo:
#   PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 48 | ForEach-Object {[char]$_})
#   Git Bash:   openssl rand -hex 32
# Si queda vacio, la integracion de Telegram queda deshabilitada (los webhooks responden 401).
TELEGRAM_WEBHOOK_SECRET=
