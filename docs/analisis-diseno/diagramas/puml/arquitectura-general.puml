@startuml
!theme plain

title Arquitectura General - KoroFin

skinparam componentStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial

package "Cliente Web (Navegador)" as ClienteWeb {
  [Next.js 16 App] as NextApp
  [Tailwind CSS v4 / shadcn]
  [Recharts (Gráficos)]
  [Context API (Auth + Notificaciones)]
}

package "Frontend (Next.js)" as FrontendServer {
  [Páginas (App Router)]
  [Componentes React]
  [Axios API Client] as Axios
  [JWT Interceptor]
}

package "Backend (Spring Boot 4)" as Backend {
  package "Controllers" {
    [UserController]
    [CategoryController]
    [IncomeController]
    [ExpenseController]
    [DebtController]
    [RecurringController]
    [AnalysisController]
    [AIChatController]
    [NotificationController]
    [ReportController]
    [StatementImportController]
    [TelegramIntegrationController]
    [CreditCardController]
    [CardMovementController]
  }

  package "Services" {
    [UserService]
    [CategoryService]
    [IncomeService]
    [ExpenseService]
    [DebtService]
    [RecurringService]
    [FinancialAnalysisService]
    [AiChatOrchestratorService]
    [NotificationService]
    [ReportService]
    [StatementImportService] as StatementImport
    [TelegramExpenseService] as TelegramExpense
    [CreditCardService]
    [CardMovementService]
  }

  package "Jobs (@Scheduled)" {
    [PaymentReminderJob]
    [WeeklySummaryJob]
    [InactivityReminderJob]
    [MonthEndPredictionJob]
  }

  package "Events" {
    [ExpenseCreatedEvent]
    [NotificationListener]
  }

  package "Security" {
    [JwtAuthenticationFilter]
    [SecurityConfig]
  }

  package "Data Access" {
    [Repositories (JPA)] as Repositories
    [Specifications]
    [Entities]
  }

  package "IA Multi-Proveedor" as IAMulti {
    [AiChatOrchestrator]
    [AiProviderRegistry]
    [FinancialContextBuilder]
    [AiChatClient] as AIClient
  }
}

database "PostgreSQL 16" as DB {
  [Tablas: users, categories, incomes, expenses]
  [Tablas: debts, debt_payments, debt_charges, recurring_payments]
  [Tablas: notifications, ai_messages, ai_usage_events]
  [Tablas: financial_analysis]
  [Tablas: telegram_links]
  [Tablas: credit_cards, card_movements, installment_plans, installments]
  [Migraciones Flyway V1-V24+]
}

package "Externo" as Ext {
  [Gemini API] as Gemini
  [NVIDIA NIM API] as Nvidia
  [OpenCode Zen API] as OpenCode
  [OpenRouter API] as OpenRouter
  [Groq API] as Groq
  [Brevo SMTP (Email)] as Brevo
  [Telegram Bot API / n8n] as TelegramBot
}

' Relaciones corregidas usando los alias declarados
NextApp --> FrontendServer : "Renderiza / Carga"
Axios --> Controllers : "HTTPS / REST API (JSON)"
Repositories --> DB : "JDBC / JPA"
AIClient --> Gemini : "HTTP (orden de intento #1)"
AIClient --> Nvidia : "HTTP / OpenAI-compatible (orden #2)"
AIClient --> OpenCode : "HTTP (orden #3)"
AIClient --> OpenRouter : "HTTP (orden #4)"
AIClient --> Groq : "HTTP (orden #5, sin key aun)"
NotificationService --> Brevo : "Email (async, degradable)"
TelegramExpense --> TelegramBot : "Webhook / API (orquestado por n8n)"

@enduml