            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Registrar gasto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer codigo": {
      "main": [
        [
          {
            "node": "Confirmar vinculo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirmar vinculo": {
      "main": [
        [
          {
            "node": "Componer respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registrar gasto": {
      "main": [
        [
          {
            "node": "Componer respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Componer respuesta": {
